# Local ConversationRelay server
PORT=3000

# Public HTTPS tunnel base URL, no trailing slash.
# Example: https://seclusion-fester-corny.ngrok-free.dev
PUBLIC_BASE_URL=

# Translation provider: aws or mock
TRANSLATION_PROVIDER=aws
AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile
# If true, failed AWS Translate calls return the original text instead of failing the call flow.
TRANSLATION_FALLBACK_ORIGINAL=true

# Inbound caller leg defaults
CALLER_NAME=Caller
CALLER_TRANSLATE_CODE=en
CALLER_LANGUAGE=en-US
CALLER_TRANSCRIPTION_PROVIDER=Deepgram
CALLER_TTS_PROVIDER=Amazon
CALLER_VOICE=Matthew-Generative

# Outbound callee/agent leg defaults
AGENT_NAME=Agent
# Amazon Translate code. Use es for Spanish translation.
AGENT_TRANSLATE_CODE=es
# ConversationRelay locale. Use es-MX for Mexican Spanish speech recognition/TTS.
AGENT_LANGUAGE=es-MX
AGENT_TRANSCRIPTION_PROVIDER=Deepgram
AGENT_TTS_PROVIDER=Amazon
AGENT_VOICE=Lupe-Generative
AGENT_PHONE_NUMBER=+15551234567

# Optional: auto-dial the agent when the caller's ConversationRelay websocket connects.
# This uses the Twilio REST API directly.
AUTO_DIAL_AGENT=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Used if Twilio's inbound webhook does not include To.
TWILIO_DEFAULT_FROM=+15557654321

# If the agent endpoint is an ACD/queue (e.g. Webex) that auto-answers before a
# human is present, require the human agent to press a key to accept. Until they
# do, the caller stays on hold music and the legs are not bridged.
AGENT_ACCEPT_DTMF=false
AGENT_ACCEPT_DIGIT=1
# How often (ms) to repeat the "press 1 to connect" prompt to the agent.
AGENT_ACCEPT_REPEAT_MS=15000
# Present the customer's number (not the Twilio number) as caller ID when dialing
# the agent, so the agent-side system can read the caller's ANI. Twilio may reject
# a number you don't own — the dial falls back to the Twilio number if so.
AGENT_DIAL_USE_CALLER_ID=false

# Voice provider test mode: each inbound call rotates to the next Polly tier
# combo (1=Generative, 2=Neural, 3=Standard) and timing events are appended to
# local-server/test-results.jsonl. See npm run report and GET /results.
PROVIDER_TEST_MODE=false
# Pin a single combo id instead of rotating.
# TEST_COMBO=1

# --- Hold music (while the caller waits for the agent to pick up) ---
# Master on/off. Set false for clean benchmark/test runs.
HOLD_MUSIC_ENABLED=true
# Looped track. Default is a Twilio sample (cowbell) — replace with a branded MP3.
HOLD_MUSIC_URL=https://api.twilio.com/cowbell.mp3
# How long after dialing the agent before the spoken reassurance line first plays.
HOLD_MUSIC_DELAY_MS=10000
# How long to wait out the spoken line before resuming music (must be >= the
# line's spoken duration, or the resumed music gets dropped by ConversationRelay).
HOLD_LINE_PAUSE_MS=7000
# After music resumes, wait this long before speaking the line again.
HOLD_MUSIC_REPEAT_MS=15000
# No-answer timeout: after this, apologize to the caller and hang up.
HOLD_TIMEOUT_MS=45000
# Reassurance line (auto-translated to the caller's language).
HOLD_MUSIC_MESSAGE=Thank you for your patience. We're still connecting you — please stay on the line.
# Apology line played on no-answer timeout (auto-translated).
HOLD_TIMEOUT_MESSAGE=We're sorry, no one is available to take your call right now. Please try again later.
