# Local ConversationRelay server
PORT=3000

# Public HTTPS tunnel base URL, no trailing slash.
# Example: https://seclusion-fester-corny.ngrok-free.dev
PUBLIC_BASE_URL=

# Translation provider: aws or mock
TRANSLATION_PROVIDER=aws
AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile
# If true, failed AWS Translate calls return the original text instead of failing the call flow.
TRANSLATION_FALLBACK_ORIGINAL=true

# Inbound caller leg defaults
CALLER_NAME=Caller
CALLER_TRANSLATE_CODE=en
CALLER_LANGUAGE=en-US
CALLER_TRANSCRIPTION_PROVIDER=Deepgram
CALLER_TTS_PROVIDER=Amazon
CALLER_VOICE=Matthew-Generative

# Outbound callee/agent leg defaults
AGENT_NAME=Agent
# Amazon Translate code. Use es for Spanish translation.
AGENT_TRANSLATE_CODE=es
# ConversationRelay locale. Use es-MX for Mexican Spanish speech recognition/TTS.
AGENT_LANGUAGE=es-MX
AGENT_TRANSCRIPTION_PROVIDER=Deepgram
AGENT_TTS_PROVIDER=Amazon
AGENT_VOICE=Lupe-Generative
AGENT_PHONE_NUMBER=+15551234567

# Optional: auto-dial the agent when the caller's ConversationRelay websocket connects.
# This uses the Twilio REST API directly.
AUTO_DIAL_AGENT=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Used if Twilio's inbound webhook does not include To.
TWILIO_DEFAULT_FROM=+15557654321

# Voice provider test mode: each inbound call rotates to the next Polly tier
# combo (1=Generative, 2=Neural, 3=Standard) and timing events are appended to
# local-server/test-results.jsonl. See npm run report and GET /results.
PROVIDER_TEST_MODE=false
# Pin a single combo id instead of rotating.
# TEST_COMBO=1
